# ── Core ───────────────────────────────────────────────────────
# Signs admin login sessions. Any long random string; keep it stable.
PAYLOAD_SECRET=

# Empty = local SQLite file (payload.db). Anything starting with
# "mongodb" switches the whole site to MongoDB Atlas.
DATABASE_URI=

# Your live address, used for sitemaps, social previews and email links.
NEXT_PUBLIC_SITE_URL=https://ammadd.com

# ── Media: Cloudflare R2 ───────────────────────────────────────
# Uploads stay on disk (./media) until all four of these are set.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# The public address files are served from — an R2 custom domain
# such as https://media.ammadd.com, or the bucket's r2.dev URL.
R2_PUBLIC_URL=

# ── Email: Hostinger SMTP ──────────────────────────────────────
# Without SMTP_HOST and SMTP_USER, mail is written to the console.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=partner@ammadd.com
SMTP_PASS=
SMTP_FROM=partner@ammadd.com
SMTP_FROM_NAME=M. Ammad
# Where new-lead notifications go. Defaults to SMTP_USER.
NOTIFY_EMAIL=partner@ammadd.com
