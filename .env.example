# ── Required ────────────────────────────────────────────────────────────────
# Long random string used to encrypt sessions / API keys.
# Generate one: https://generate-secret.vercel.app/32
PAYLOAD_SECRET=replace-me-with-a-long-random-string

# ── Database ────────────────────────────────────────────────────────────────
# Production: MongoDB Atlas connection string (free M0 cluster works fine)
#   e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/ammad-portfolio
# Leave empty in local development to use a zero-setup local SQLite file.
DATABASE_URI=

# ── Media storage (production) ──────────────────────────────────────────────
# Vercel Blob read/write token (Vercel Dashboard → Storage → Blob).
# Leave empty in local development to store uploads in ./media on disk.
BLOB_READ_WRITE_TOKEN=

# ── Site URL ────────────────────────────────────────────────────────────────
# Used for sitemap / canonical URLs / CORS. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://ammadd.com
